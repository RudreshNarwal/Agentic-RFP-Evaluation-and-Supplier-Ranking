# Copy to .env for local runs (gitignored). Same keys as .streamlit/secrets.toml.example (used on Streamlit Cloud).
# Leave LLM_PROVIDER=mock to run without any key.
LLM_PROVIDER=gemini             # anthropic | openai | gemini | openrouter | mock
LLM_MODEL=gemini-3.8-flash      # optional override of the provider default

# Gemini: Google AI Studio (false) or Vertex AI (true)
GEMINI_USE_VERTEX_AI=false
GOOGLE_API_KEY=                 # AI Studio key, or a Vertex AI express-mode key when the flag is true
# GOOGLE_CLOUD_PROJECT=         # Vertex with Application Default Credentials instead of an API key
# GOOGLE_CLOUD_LOCATION=global

# ANTHROPIC_API_KEY=            # LLM_PROVIDER = anthropic (default model claude-sonnet-5)
# OPENAI_API_KEY=               # LLM_PROVIDER = openai    (default model gpt-5-mini)
# OPENROUTER_API_KEY=           # LLM_PROVIDER = openrouter (default model anthropic/claude-sonnet-5)
